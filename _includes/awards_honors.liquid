<div class="awards_honors">
  {% if site.awards_honors != blank %}
    {% assign awards_list = "Outstanding Graduates, Xidian University, 2025|Outstanding Student, Xidian University, 2024, 2025|ACM MM 2024 Honourable Mention Award, 2024|National Scholarship，2024" | split: "|" %}
    {% assign awards_size = awards_list | size %}
    <div
      class="table-responsive"
      {% if page.awards_honors.scrollable and awards_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <ul>
        {% if page.awards_honors.limit %}
          {% assign awards_limit = page.awards_honors.limit %}
        {% else %}
          {% assign awards_limit = awards_size %}
        {% endif %}
        {% for award in awards_list limit: awards_limit %}
          <li>{{ award }}</li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No awards so far...</p>
  {% endif %}
</div>
